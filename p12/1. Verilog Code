module fifo_memory #(
    parameter DATA_WIDTH = 8,
    parameter DEPTH = 16
)(
    input  wire                   clk,
    input  wire                   reset,
    input  wire                   wr_en,
    input  wire                   rd_en,
    input  wire [DATA_WIDTH-1:0]  data_in,

    output reg  [DATA_WIDTH-1:0]  data_out,
    output wire                   full,
    output wire                   empty
);

    reg [DATA_WIDTH-1:0] memory [0:DEPTH-1];

    reg [4:0] write_ptr;
    reg [4:0] read_ptr;
    reg [5:0] count;

    assign empty = (count == 0);
    assign full  = (count == DEPTH);

    always @(posedge clk or posedge reset) begin
        if (reset) begin
            write_ptr <= 0;
            read_ptr  <= 0;
            count     <= 0;
            data_out  <= 0;
        end
        else begin

            // Write operation
            if (wr_en && !full) begin
                memory[write_ptr] <= data_in;
                write_ptr <= write_ptr + 1;
            end

            // Read operation
            if (rd_en && !empty) begin
                data_out <= memory[read_ptr];
                read_ptr <= read_ptr + 1;
            end

            // Count update
            case ({wr_en && !full, rd_en && !empty})
                2'b10: count <= count + 1;
                2'b01: count <= count - 1;
                default: count <= count;
            endcase
        end
    end

endmodule