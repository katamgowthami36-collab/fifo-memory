`timescale 1ns/1ps

module fifo_memory_tb;

    parameter DATA_WIDTH = 8;
    parameter DEPTH = 16;

    reg clk;
    reg reset;
    reg wr_en;
    reg rd_en;
    reg [DATA_WIDTH-1:0] data_in;

    wire [DATA_WIDTH-1:0] data_out;
    wire full;
    wire empty;

    fifo_memory #(
        .DATA_WIDTH(DATA_WIDTH),
        .DEPTH(DEPTH)
    ) DUT (
        .clk(clk),
        .reset(reset),
        .wr_en(wr_en),
        .rd_en(rd_en),
        .data_in(data_in),
        .data_out(data_out),
        .full(full),
        .empty(empty)
    );

    // Clock generation
    always #5 clk = ~clk;

    initial begin

        $dumpfile("waveform.vcd");
        $dumpvars(0, fifo_memory_tb);

        clk = 0;
        reset = 1;
        wr_en = 0;
        rd_en = 0;
        data_in = 0;

        // Reset
        #10;
        reset = 0;

        // Write data
        #10;
        wr_en = 1;
        data_in = 8'hA1;

        #10;
        data_in = 8'hB2;

        #10;
        data_in = 8'hC3;

        #10;
        data_in = 8'hD4;

        // Stop writing
        #10;
        wr_en = 0;

        // Read data
        #10;
        rd_en = 1;

        #10;
        rd_en = 1;

        #10;
        rd_en = 1;

        #10;
        rd_en = 1;

        #10;
        rd_en = 0;

        #20;
        $finish;

    end

    // Monitor signals
    initial begin
        $monitor("Time=%0t | Reset=%b | WR=%b | RD=%b | Data_In=%h | Data_Out=%h | Full=%b | Empty=%b",
                 $time, reset, wr_en, rd_en, data_in, data_out, full, empty);
    end

endmodule